# Arpa W1 — copy to .env and fill. No secrets committed.

# Postgres (compose default)
DATABASE_URL=postgresql+asyncpg://arpa:arpa@localhost:5432/arpa
# Sync URL for Alembic / PostgresSaver (psycopg)
DATABASE_URL_SYNC=postgresql://arpa:arpa@localhost:5432/arpa

# JWT — local HS256 stub (Google JWKS later)
JWT_SECRET=dev-only-change-me-not-a-real-secret-32b-min
JWT_ISSUER=arpa-local
JWT_AUDIENCE=arpa-api
JWT_ALGORITHM=HS256
# Google-ready stubs (unused until IdP wired):
# JWT_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# OpenRouter — leave empty for local smoke without LLM
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini
OPENROUTER_ALLOWLIST=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet

# Folder jail root for tool writes
ALLOWED_ROOT=/workspace/arpa-scaffold/workspace_data

# LangSmith (optional — skip gracefully if absent)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=arpa-v1

# API
API_HOST=0.0.0.0
API_PORT=8000
